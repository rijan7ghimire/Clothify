<%@ Master Language="C#" AutoEventWireup="true" CodeFile="AdminMaster.master.cs" Inherits="Clothify.Admin.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Clothify Admin Panel</title>
    <link rel="stylesheet" href="<%: ResolveUrl("~/css/style.css") %>" />
    <style>
        .admin-header {
            background: var(--primary);
            color: #fff;
            position: fixed;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 480px;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 16px;
            height: 56px;
            box-sizing: border-box;
        }
        .admin-header .brand {
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .admin-logout {
            background: var(--error);
            color: #fff;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }
        .admin-side-nav {
            background: var(--light-gray);
            padding: 12px 16px;
            margin-bottom: 16px;
            border-radius: 12px;
        }
        .admin-side-nav .nav-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #999;
            margin-bottom: 8px;
        }
        .admin-side-nav a {
            display: block;
            padding: 10px 12px;
            color: var(--text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            margin-bottom: 2px;
        }
        .admin-side-nav a:hover,
        .admin-side-nav a.active {
            background: var(--primary);
            color: #fff;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Admin Top Header -->
        <header class="admin-header">
            <span class="brand">CLOTHIFY ADMIN PANEL</span>
            <asp:Button ID="btnLogout" runat="server" Text="Logout" CssClass="admin-logout" OnClick="btnLogout_Click" CausesValidation="false" />
        </header>

        <!-- Main Content -->
        <main class="main-content">

            <!-- Management Side Navigation -->
            <div class="admin-side-nav">
                <div class="nav-title">Management</div>
                <a href="<%: ResolveUrl("~/Admin/ManageUsers.aspx") %>">
                    <span>&#128101;</span> Manage Users
                </a>
                <a href="<%: ResolveUrl("~/Admin/ManageProducts.aspx") %>">
                    <span>&#128722;</span> Manage Products
                </a>
                <a href="<%: ResolveUrl("~/Admin/ManageCategories.aspx") %>">
                    <span>&#128193;</span> Manage Categories
                </a>
                <a href="<%: ResolveUrl("~/Admin/ManageOrders.aspx") %>">
                    <span>&#128230;</span> Manage Orders
                </a>
                <a href="<%: ResolveUrl("~/Admin/ManageFeedback.aspx") %>">
                    <span>&#128172;</span> Manage Feedback
                </a>
            </div>

            <asp:ContentPlaceHolder ID="AdminContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <!-- Admin Bottom Navigation -->
        <nav class="bottom-nav">
            <a href="<%: ResolveUrl("~/Admin/Dashboard.aspx") %>" class="nav-item" id="navDashboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>HOME</span>
            </a>
            <a href="<%: ResolveUrl("~/Admin/Alerts.aspx") %>" class="nav-item" id="navAlerts">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span>ALERTS</span>
            </a>
            <a href="<%: ResolveUrl("~/Admin/Reports.aspx") %>" class="nav-item" id="navReports">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span>REPORTS</span>
            </a>
            <a href="<%: ResolveUrl("~/Admin/Settings.aspx") %>" class="nav-item" id="navSettings">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                <span>SETTINGS</span>
            </a>
        </nav>

    </form>

    <div id="toast-container"></div>
    <script src="<%: ResolveUrl("~/js/script.js") %>"></script>
</body>
</html>
